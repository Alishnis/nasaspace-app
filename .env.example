# NASA TEMPO Air Quality Monitor - environment variables
# Copy to .env and edit:  cp .env.example .env
# Every variable is optional for local development; defaults are noted below.
# NEVER commit your real .env file.

# --- Server ---
# HTTP port (default: 3003)
PORT=3003

# --- Cache ---
# Redis is optional. If it is unreachable the app uses an in-memory cache.
# (defaults: localhost / 6379; docker-compose sets REDIS_HOST=redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
# Secret used to sign JWTs for /api/users/*.
# If unset, a random secret is generated at startup (tokens stop working on restart).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Email alerts (Nodemailer) ---
# If EMAIL_USER or EMAIL_PASS is empty, emails are only logged to the console (no mail is sent).
# EMAIL_SERVICE is a Nodemailer service name (default: gmail). To use a custom SMTP
# server instead, set EMAIL_HOST (and optionally EMAIL_PORT, default 587).
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587

# --- External data APIs ---
# NOTE: these are read by the code but NOT used yet. TEMPO, weather and ground-station
# data are currently generated locally (see "Limitations" in the README).
# TEMPO_API_KEY defaults to DEMO_KEY; TEMPO_API_URL defaults to https://api.nasa.gov/tempo
TEMPO_API_KEY=
TEMPO_API_URL=https://api.nasa.gov/tempo
WEATHER_API_KEY=
